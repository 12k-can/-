#!/bin/bash
# 一键整理桌面 & 指定文件夹
# 双击此文件即可运行（会自动打开终端）

cd "$(dirname "$0")"
echo "========================================"
echo "  🧹 开始整理桌面文件..."
echo "========================================"
echo ""

python3 organizer.py --run

echo ""
echo "========================================"
echo "  ✅ 整理完成！按回车键关闭此窗口"
echo "========================================"
read -r
